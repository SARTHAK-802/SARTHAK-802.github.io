{% assign repos = site.data.featured_repos %}

<div class="repo-grid">
  {% for repo in repos %}
    <div class="repo-card">

      <div class="repo-top">
        <div class="repo-title">
          <a href="{{ repo.url }}" target="_blank" rel="noopener noreferrer">{{ repo.name }}</a>
        </div>

        {% if repo.tag %}
          <span class="repo-tag">{{ repo.tag }}</span>
        {% endif %}
      </div>

      {% if repo.description %}
        <p class="repo-desc">{{ repo.description }}</p>
      {% endif %}

      {% if repo.tech %}
        <div class="repo-tech">
          {% for t in repo.tech %}
            <span class="tech-pill">{{ t }}</span>
          {% endfor %}
        </div>
      {% endif %}

      <div class="repo-buttons">
        <a class="btn-repo" href="{{ repo.url }}" target="_blank" rel="noopener noreferrer">GitHub</a>

        {% if repo.docs %}
          <a class="btn-repo alt" href="{{ repo.docs }}" target="_blank" rel="noopener noreferrer">Docs</a>
        {% endif %}

        {% if repo.demo %}
          <a class="btn-repo alt" href="{{ repo.demo }}" target="_blank" rel="noopener noreferrer">Demo</a>
        {% endif %}

        {% if repo.paper %}
          <a class="btn-repo alt" href="{{ repo.paper }}" target="_blank" rel="noopener noreferrer">Paper</a>
        {% endif %}
      </div>

    </div>
  {% endfor %}
</div>
